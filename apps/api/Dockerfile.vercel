
FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.28.5 --activate

# Configuración del workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json

# Instalar dependencias necesarias para la API
RUN pnpm install --filter ./apps/api... --frozen-lockfile

# Copiar el código de la API
COPY apps/api/ ./apps/api/

# Generar Prisma Client y compilar NestJS
WORKDIR /app/apps/api
ENV DATABASE_URL="postgresql://user:password@localhost:5432/tournament_manager"
RUN pnpm build

# Imagen de ejecución
FROM node:22-bookworm-slim AS production

WORKDIR /app

ENV NODE_ENV=production

# Dependencias y aplicación compilada
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/package.json ./package.json

WORKDIR /app/apps/api

EXPOSE 3000

CMD ["node", "dist/main.js"]
